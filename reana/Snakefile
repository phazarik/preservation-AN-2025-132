# ------------------------------------------------------------------------------
# REANA SNAKEMAKE WORKFLOW (Chunked Edition)
#
# The workflow has three stages:
#
#   1. Process NanoAOD input files in chunks on CERN HTCondor.
#   2. Merge the per-chunk ROOT outputs for each sample.
#   3. Copy the merged ROOT files to the configured EOS directory.
#
# Every *.json file under reana/samples/ describes one sample: its full list of
# input files plus its processing parameters (era, sample name, output
# filename). The sample key is simply the file's basename (e.g. dyv12.json
# defines the sample "dyv12"). Adding, removing, or editing a sample - or
# creating a small test_sample.json for quick debugging - is handled by
# editing files in that directory. See reana/prepare.py for how the sample
# files are generated from DAS.
# ------------------------------------------------------------------------------

import os
import glob
import json
import math

# ------------------------------------------------------------------------------
# Docker image used for all workflow steps.
#
# NOTE: We use the official CMS Enterprise Linux 8 (EL8) base image. This 
# perfectly matches the SCRAM_ARCH (el8_amd64_gcc12) used to set up the 
# CMSSW environment, ensuring all compiled C++ code links natively against
# the correct system libraries.
# ------------------------------------------------------------------------------
CONTAINER = "docker://cmssw/el8:x86_64"

# Directory structure inside the REANA workspace.
# Individual chunk outputs are kept in outputs/tmp until they are merged.
OUTPUT_DIR = "outputs"
TMP_DIR = f"{OUTPUT_DIR}/tmp"

# Directory containing one self-contained JSON file per sample (files +
# parameters). See reana/prepare.py for how these are generated from DAS,
# or write one by hand (e.g. test_sample.json) for a quick local test.
SAMPLES_DIR = "reana/samples"

# HTCondor runtime flavour used for all process_chunk jobs.
HTCONDOR_MAX_RUNTIME = "workday"

# EOS destination for the final merged ROOT files.
# The value is supplied through reana.yaml.
EOS_OUTPUT_DIR = config.get("eos_output_dir", "/tmp/default_fallback")

# Set how many input NanoAOD files to process per HTCondor job.
# This prevents DDoS-ing the REANA scheduler and reduces job startup overhead.
CHUNK_SIZE = 1 # --> Set this to 20/50 for large submission; 1 = test on a few files

# ------------------------------------------------------------------------------
# Discover samples
# Every *.json file under SAMPLES_DIR describes one sample and has the form:
#   {
#     "files": ["root://.../a.root", "root://.../b.root", ...],
#     "parameters": {"sample": "...", "era": "...", "output": "outputs/..."}
#   }
# Entries in "files" starting with "root://" are read remotely via XRootD
# (e.g. from DAS); anything else is treated as a local path, which must be
# included in the REANA workspace via reana.yaml's inputs section so it is
# actually present when the job runs.
# ------------------------------------------------------------------------------

SAMPLE_JSON_PATHS = {
    os.path.splitext(os.path.basename(path))[0]: path
    for path in sorted(glob.glob(f"{SAMPLES_DIR}/*.json"))
}

if not SAMPLE_JSON_PATHS:
    raise FileNotFoundError(f"[ERROR] No sample files found in {SAMPLES_DIR}/")

def load_sample(path):
    with open(path, "r") as f:
        return json.load(f)

SAMPLES = {key: load_sample(path) for key, path in SAMPLE_JSON_PATHS.items()}

# Restrict Snakemake wildcards to the discovered sample keys and integer
# chunk indices.
wildcard_constraints:
    sample_key = "|".join(SAMPLES.keys()),
    chunk_index = r"\d+"

# Calculate the number of chunks required for each sample.
SAMPLE_CHUNKS = {
    key: math.ceil(len(sample["files"]) / CHUNK_SIZE)
    for key, sample in SAMPLES.items()
}

# ------------------------------------------------------------------------------
# Define per-chunk outputs
# There is one job per chunk. This produces one temporary ROOT file per chunk.
# ------------------------------------------------------------------------------

PER_CHUNK_OUTPUTS = {}
for key, num_chunks in SAMPLE_CHUNKS.items():
    PER_CHUNK_OUTPUTS[key] = [
        f"{TMP_DIR}/hst_{key}_chunk{i}.root"
        for i in range(num_chunks)
    ]

# Map each final output filename to its sample key.
# This is used by merge_sample to determine which per-chunk outputs belong
# to each sample.
OUTPUT_MAP = {
    sample["parameters"]["output"]: key
    for key, sample in SAMPLES.items()
}
ALL_MERGED_OUTPUTS = list(OUTPUT_MAP.keys())

def get_sample_key(filename):
    # Return the sample key corresponding to a final output filename.
    return OUTPUT_MAP[f"{OUTPUT_DIR}/{filename}"]

# ------------------------------------------------------------------------------
# Final workflow target
# Snakemake considers the workflow complete when the .published marker exists.
# The marker is created only after all samples have been processed, merged,
# and successfully copied to EOS.
# ------------------------------------------------------------------------------

rule all:
    input:
        f"{OUTPUT_DIR}/.published"

# ------------------------------------------------------------------------------
# Process chunks of NanoAOD files
#
# The job:
#   1. Reads the sample's own JSON file (files + parameters).
#   2. Selects the appropriate CHUNK of input files.
#   3. Runs compile_and_run.C for each file in the chunk.
#   4. Merges them internally to produce one ROOT output file for the chunk.
#
# Each job only depends on its own sample's JSON file (sample_config below).
# This ensures that editing or regenerating one sample does not invalidate
# already-computed chunks belonging to other samples.
#
# Jobs are submitted to the CERN HTCondor backend. Kerberos authentication is
# required for submitting to the CERN HTCondor cluster, while the VOMS proxy
# allows the worker job to access CMS resources such as XRootD input files.
# ------------------------------------------------------------------------------

rule process_chunk:
    input:
        wrapper = "reana/runJob.py",
        # Every sample file is named exactly "<sample_key>.json". The path
        # is deterministic from the wildcard alone, avoiding the need for
        # lambda lookups which cannot be serialized by REANA's workflow parser.
        sample_config = f"{SAMPLES_DIR}/{{sample_key}}.json",
        deps = [
            "compile_and_run.C",
            "runOnce.C",
            "nanoAna.C",
            "nanoAna.h"
        ] + glob.glob("headers/*.h") + [
            path for path in glob.glob("trainedDNNs/**", recursive=True)
            if os.path.isfile(path)
        ]
    output:
        outfile = f"{TMP_DIR}/hst_{{sample_key}}_chunk{{chunk_index}}.root"
    container:
        CONTAINER
    resources:
        compute_backend = "htcondorcern",
        htcondor_max_runtime = HTCONDOR_MAX_RUNTIME,
        kubernetes_memory_limit = "4G",
        kerberos = True
        # voms_proxy = True # bypassed by manually uploading the proxy
    shell:
        """
        mkdir -p {TMP_DIR}
        source /cvmfs/cms.cern.ch/cmsset_default.sh
        export SCRAM_ARCH=el8_amd64_gcc12
        scramv1 project CMSSW CMSSW_14_1_0_pre4
        cd CMSSW_14_1_0_pre4/src
        eval `scramv1 runtime -sh`
        cd ../../
        
        export XRD_NETWORKTIMEOUT=60
        export XRD_CONNECTIONRETRY=2
        export XRD_REQUESTTIMEOUT=60
        
        python3 -u {input.wrapper} {wildcards.sample_key} {wildcards.chunk_index} {CHUNK_SIZE} {output.outfile}
        """

# ------------------------------------------------------------------------------
# Merge outputs for each sample
# Once all chunks belonging to a sample have been processed, hadd combines
# their temporary ROOT files into a single ROOT file.
# ------------------------------------------------------------------------------

rule merge_sample:
    input:
        lambda wildcards: PER_CHUNK_OUTPUTS[
            get_sample_key(wildcards.filename)
        ]
    output:
        f"{OUTPUT_DIR}/{{filename}}"
    container:
        "docker://reanahub/reana-env-root6:6.38.00"
    shell:
        "hadd -f {output} {input}"

# ------------------------------------------------------------------------------
# Publish merged outputs to EOS
# This step runs only after all samples have been processed and merged.
# Kerberos authentication is required to access the CERN EOS filesystem.
# The .published marker is created only if the copy command completes
# successfully.
# ------------------------------------------------------------------------------

rule publish_to_eos:
    input:
        ALL_MERGED_OUTPUTS
    output:
        touch(f"{OUTPUT_DIR}/.published")
    container:
        CONTAINER
    resources:
        kerberos = True
    shell:
        """
        mkdir -p {EOS_OUTPUT_DIR}
        cp {input} {EOS_OUTPUT_DIR}/
        """

